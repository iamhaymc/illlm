# The checkpoints under `ckpt/` are stored with Git LFS.
#
# The weight files are hundreds of megabytes to gigabytes of opaque binary;
# keeping them in the object store would put a whole copy of every shard in
# history for every revision of it, and `tokenizer.json` is tens of megabytes
# of one long line that no diff can usefully describe. Everything else in the
# repository is text and is left exactly as git already handles it — no `text`
# or `eol` rules here, so adding this file renormalizes nothing.
ckpt/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
ckpt/**/tokenizer.json filter=lfs diff=lfs merge=lfs -text

ckpt/**/*.pt filter=lfs diff=lfs merge=lfs -text
data/*.zip filter=lfs diff=lfs merge=lfs -text
